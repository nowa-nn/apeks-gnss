#!/usr/bin/env bash
set -euo pipefail

repo='https://github.com/nowa-nn/apeks-gnss.git'
releases='/opt/apeks/releases'
mkdir -p "$releases"
install -d -o apeks -g apeks -m 755 /var/lib/apeks/uploads
install -d -o apeks -g apeks -m 700 /var/lib/apeks/private-uploads
sha="$(git ls-remote "$repo" refs/heads/backend | cut -f1)"
test -n "$sha"
current="$(readlink -f /opt/apeks/current 2>/dev/null || true)"
if [[ "$current" == "$releases/$sha" ]]; then
  exit 0
fi

candidate="$releases/$sha"
if [[ ! -d "$candidate/.git" ]]; then
  git clone --quiet --depth 1 --branch backend "$repo" "$candidate"
fi
cd "$candidate/backend"
set -a
source /etc/apeks/medusa.env
set +a
npm ci --include=dev --no-audit --no-fund
npm run build
ln -sfn ../../node_modules .medusa/server/node_modules
./node_modules/.bin/medusa db:migrate
if [[ ! -e /var/lib/apeks/seeded ]]; then
  npm run seed
  touch /var/lib/apeks/seeded
fi
chown -R apeks:apeks "$candidate"
install -m 644 "$candidate/deploy/nginx.conf" /etc/nginx/sites-available/apeks
nginx -t
systemctl reload nginx
install -m 644 "$candidate/deploy/apeks-medusa.service" /etc/systemd/system/apeks-medusa.service
install -m 644 "$candidate/deploy/apeks-update.service" /etc/systemd/system/apeks-update.service
install -m 644 "$candidate/deploy/apeks-update.timer" /etc/systemd/system/apeks-update.timer
install -m 644 "$candidate/deploy/apeks-cert-renew.service" /etc/systemd/system/apeks-cert-renew.service
install -m 644 "$candidate/deploy/apeks-cert-renew.timer" /etc/systemd/system/apeks-cert-renew.timer
install -m 755 "$candidate/deploy/apeks-update" /usr/local/sbin/apeks-update
systemctl daemon-reload
ln -sfn "$candidate" /opt/apeks/current
systemctl restart apeks-medusa.service
systemctl is-active --quiet apeks-medusa.service

for release in "$releases"/*; do
  [[ -d "$release" ]] || continue
  [[ "$release" == "$candidate" || "$release" == "$current" ]] && continue
  rm -rf -- "$release"
done
